# Copie para .env e preencha. O .env NÃO vai para o Git.

# Token pessoal da Supabase (https://supabase.com/dashboard/account/tokens)
# Necessário só em CI ou quando não usar `supabase login`.
SUPABASE_ACCESS_TOKEN=

# Referência do projeto (aparece na URL do dashboard: /project/<ref>)
SUPABASE_PROJECT_REF=

# Senha do banco do projeto remoto (usada por db push/pull)
SUPABASE_DB_PASSWORD=
